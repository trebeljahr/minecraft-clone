# Everything under /dist/ is content-hashed by webpack.prod.js
# (dist/[name].[contenthash].js), and index.html is generated by
# HtmlWebpackPlugin so its <script> always points at the current hash.
# A changed bundle therefore gets a new URL and no browser can pin a stale
# one, which is what makes `immutable` safe here.
# Verified live: /dist/* also matches nested paths like /dist/workers/*.
/dist/*
  Cache-Control: public, max-age=31536000, immutable

# Textures, icons and CSS are committed files with stable, unhashed names:
# src/blocks.ts and src/voxelMaterial.ts request them by literal URL, so they
# never go through webpack and never get a hash. A stale one is still wrong,
# so cap the TTL at a day.
/assets/*
  Cache-Control: public, max-age=86400

/styles/*
  Cache-Control: public, max-age=86400
