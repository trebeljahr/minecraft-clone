{
  "name": "minecraft-clone",
  "version": "0.0.1",
  "description": "A simple minecraft clone that can be played online in the browser",
  "author": "Rico Trebeljahr",
  "main": "app.js",
  "scripts": {
    "dev": "webpack-dev-server --open --config webpack.dev.js",
    "build": "webpack --config webpack.prod.js",
    "test": "./node_modules/jest/bin/jest.js",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "check": "biome check --write .",
    "prepare": "husky"
  },
  "dependencies": {
    "@shopify/draggable": "^1.0.0-beta.8",
    "@types/dat.gui": "^0.7.6",
    "dat.gui": "^0.7.7",
    "perlin-noise-3d": "^0.5.4",
    "threads": "^1.6.5",
    "three": "latest",
    "webpack-cleanup-plugin": "^0.5.1"
  },
  "devDependencies": {
    "@babel/types": "^7.15.0",
    "@biomejs/biome": "^1.9.4",
    "@types/jest": "^27.4.1",
    "@types/three": "^0.184.0",
    "@types/webpack-merge": "^5.0.0",
    "css-loader": "^3.2.0",
    "html-webpack-plugin": "^5.5.0",
    "husky": "^9.1.7",
    "jest": "^27.5.1",
    "lint-staged": "^16.4.0",
    "source-map-loader": "^0.2.4",
    "style-loader": "^1.0.0",
    "terser": "^5.46.2",
    "terser-webpack-plugin": "^5.5.0",
    "ts-jest": "^27.1.3",
    "ts-loader": "^9.2.8",
    "typescript": "^5.6.3",
    "webpack": "^5.0.0",
    "webpack-cli": "^4.9.2",
    "webpack-dev-server": "^4.7.4",
    "webpack-merge": "^4.2.1"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,jsonc,css}": ["biome check --write --no-errors-on-unmatched"]
  }
}
