{
  "name": "minecraft-clone",
  "version": "0.0.1",
  "packageManager": "pnpm@10.33.2",
  "description": "A simple minecraft clone that can be played online in the browser",
  "author": "Rico Trebeljahr",
  "main": "app.js",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "webpack-dev-server --open --config webpack.dev.js",
    "prebuild": "node scripts/generate-seo.mjs",
    "build": "webpack --config webpack.prod.js",
    "test": "./node_modules/jest/bin/jest.js",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "check": "biome check --write .",
    "prepare": "husky"
  },
  "dependencies": {
    "@shopify/draggable": "^1.0.0-beta.8",
    "@types/dat.gui": "^0.7.6",
    "dat.gui": "^0.7.7",
    "perlin-noise-3d": "^0.5.4",
    "threads": "^1.6.5",
    "three": "~0.184.0",
    "webpack-cleanup-plugin": "^0.5.1"
  },
  "devDependencies": {
    "@babel/types": "^7.29.8",
    "@biomejs/biome": "^2.5.14",
    "@types/jest": "^29.5.14",
    "@types/three": "^0.184.1",
    "@types/webpack-merge": "^5.0.0",
    "css-loader": "^7.1.5",
    "html-webpack-plugin": "^5.6.8",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "lint-staged": "^16.4.0",
    "source-map-loader": "^0.2.4",
    "style-loader": "^1.3.0",
    "terser": "^5.51.2",
    "terser-webpack-plugin": "^5.6.1",
    "ts-jest": "^29.4.14",
    "ts-loader": "^9.6.2",
    "typescript": "^5.9.3",
    "webpack": "^5.111.1",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^5.2.6",
    "webpack-merge": "^4.2.2"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,jsonc,css}": [
      "biome check --write --no-errors-on-unmatched"
    ]
  },
  "pnpm": {
    "overrides": {
      "minimatch@3": "3.1.4",
      "sockjs>uuid": "11.1.1",
      "loader-utils@1": "1.4.2",
      "loader-utils@2": "2.0.4",
      "json5@1": "1.0.2",
      "json5@2": "2.2.3",
      "follow-redirects": "1.16.0",
      "async@2": "2.6.4",
      "braces@3": "3.0.3",
      "micromatch@4": "4.0.8",
      "@babel/helpers@7": "7.29.7",
      "@babel/traverse@7": "7.29.7",
      "@babel/core@7": "7.29.6",
      "cross-spawn@7": "7.0.6",
      "js-yaml@3": "3.15.2",
      "semver@6": "6.3.1",
      "ajv@6": "6.14.0",
      "ajv@8": "8.18.0",
      "picomatch@2": "2.3.2",
      "lodash": "4.18.1",
      "websocket-driver": "0.7.5",
      "browserslist@4": "4.28.7",
      "fflate@0.8": "0.8.3"
    }
  }
}
